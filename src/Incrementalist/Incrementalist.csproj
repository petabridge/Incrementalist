<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <Description>Library for running incremental, Git-based builds and tests in .NET and .NET Core.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Libgit2Sharp"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Common"/>
        <PackageReference Include="Microsoft.Extensions.Logging"/>
        <!-- CVE-2026-26171 / CVE-2026-33116: patched version for .NET 8.0 runtime -->
        <PackageReference Include="System.Security.Cryptography.Xml" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Incrementalist.Cmd"/>
    </ItemGroup>
</Project>
